{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:base",
    "github>Netcracker/renovate-config:github-actions",
    "github>Netcracker/renovate-config:netcracker-dependencies",
    "github>Netcracker/renovate-config:grafana-plugins",
    ":enablePreCommit"
  ],
  "platformAutomerge": true,
  "dockerfile": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Automerge low-risk updates once the required checks pass. Major bumps stay manual.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    }
  ]
}
